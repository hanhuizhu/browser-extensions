{
  "manifest_version": 3,
  "name": "AI 阅读助手",
  "version": "1.0.0",
  "description": "一键总结当前网页内容，帮助快速阅读消费（底层调用 DeepSeek）",
  "permissions": ["activeTab", "scripting", "storage"],
  "host_permissions": ["https://api.deepseek.com/*"],
  "action": {
    "default_popup": "popup.html",
    "default_title": "AI 阅读助手：总结本页"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": false
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
